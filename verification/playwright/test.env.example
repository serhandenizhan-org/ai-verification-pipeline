# Playwright E2E testleri için ortam değişkenleri şablonu.
# cp test.env.example test.env  ve gerçek TEST MODE değerlerini doldurun.
# test.env asla commit edilmez (.gitignore'da).
#
# ÖNEMLİ: Buraya YALNIZCA Stripe TEST MODE key'leri (sk_test_..., pk_test_...)
# girilir. sk_live_ ile başlayan bir key varsa scripts/check_stripe_key_mode.sh
# pipeline'ı otomatik durdurur.

BASE_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Stripe'ın resmi test kartı — gerçek para hareketi asla olmaz.
TEST_CARD_NUMBER=4242424242424242
TEST_CARD_DECLINED_NUMBER=4000000000000002

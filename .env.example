# Bu dosya bir ŞABLONdur. Gerçek değerleri buraya YAZMAYIN.
# Gerçek değerler için: cp .env.example .env  ve  .env dosyasını doldurun.
# .env asla commit edilmez (.gitignore'da).

# --- Telegram bildirimleri (orchestrator/notifier.py) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Stripe (yalnızca TEST MODE key'leri) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Codex entegrasyonu (verification.yml içinde kullanılır) ---
# API key GEREKMİYOR — `codex` CLI, Mac mini'de ChatGPT hesabıyla
# `codex login --device-auth` ile bir kere authenticate edilir, kimlik
# bilgisi ~/.codex altında saklanır (bkz. HANDOFF.md 4.8). Bu satır
# kasıtlı olarak boş bırakıldı.

# --- Risk / Circuit Breaker ayarları (opsiyonel override) ---
MAX_ITERATIONS=3
MAX_SAME_FAILURE=2

# --- Verification Ledger (orchestrator/ledger.py) ---
# PostgreSQL — JSON dosya bazlı eski ledger'dan taşındı (bkz. HANDOFF.md 3.3,
# orchestrator/schema.sql). Tanımlı değilse Mac mini'deki local dev instance'a
# düşer: postgresql://pipeline_app@localhost/verification_pipeline
DATABASE_URL=postgresql://pipeline_app@localhost/verification_pipeline
